{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.2.0/research-mode.schema.json",
  "x-rwb-document-kind": "research_mode",
  "title": "Research Mode v0.2",
  "type": "object",
  "required": [
    "schema_version", "mode_id", "version", "applies_when", "action_refs",
    "claim_rules", "human_decisions", "risk_rules", "migration"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "mode_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "version": { "const": "0.2.0" },
    "applies_when": { "$ref": "common.schema.json#/$defs/stringArray" },
    "action_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "mode_id", "version", "path", "sha256"],
        "properties": {
          "action_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "mode_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "version": { "$ref": "common.schema.json#/$defs/semver" },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "claim_rules": {
      "type": "object",
      "required": ["allows"],
      "properties": {
        "allows": { "$ref": "common.schema.json#/$defs/stringArray" },
        "forbids_without_other_mode": { "$ref": "common.schema.json#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "human_decisions": { "$ref": "common.schema.json#/$defs/stringArray" },
    "risk_rules": { "$ref": "common.schema.json#/$defs/stringArray" },
    "migration": {
      "type": "object",
      "required": [
        "migration_id", "source_schema_version", "source_mode_version",
        "source_hash", "implementation"
      ],
      "properties": {
        "migration_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "source_schema_version": { "const": "0.1.0" },
        "source_mode_version": { "const": "0.1.0" },
        "source_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "implementation": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  },
  "not": { "required": ["recommended_skill_capabilities"] },
  "additionalProperties": false
}
