{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/agent-trace-actors.schema.json",
  "title": "Agent Trace Actor Registry",
  "x-rwb-document-kind": "agent_trace_actors",
  "type": "object",
  "required": ["schema_version", "task_id", "task_revision", "attempt_id", "actors"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "attempt_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actor_id", "actor_type", "role", "runtime_identity", "accountable_owner"],
        "properties": {
          "actor_id": { "$ref": "#/$defs/actorId" },
          "actor_type": { "enum": ["agent", "human", "runtime-adapter", "local-tool", "model-provider"] },
          "role": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "runtime_identity": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "runtime_snapshot_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
          "accountable_owner": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "actorId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  },
  "additionalProperties": false
}
