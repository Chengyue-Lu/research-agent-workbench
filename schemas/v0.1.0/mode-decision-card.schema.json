{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/mode-decision-card.schema.json",
  "title": "Mode Decision Card",
  "x-rwb-document-kind": "mode_decision_card",
  "type": "object",
  "required": [
    "schema_version", "card_id", "mode_id", "mode_version", "mode_ref",
    "decision_basis", "rules", "combination_rules", "fixture_ids",
    "change_gate", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "card_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "mode_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "mode_version": { "$ref": "common.schema.json#/$defs/semver" },
    "mode_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "decision_basis": {
      "type": "object",
      "required": [
        "research_output_required", "applies_evidence_bases",
        "does_not_apply_evidence_bases", "ambiguous_evidence_bases"
      ],
      "properties": {
        "research_output_required": { "type": "boolean" },
        "applies_evidence_bases": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceBasis" }
        },
        "does_not_apply_evidence_bases": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceBasis" }
        },
        "ambiguous_evidence_bases": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceBasis" }
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": ["triggers", "non_triggers", "boundaries"],
      "properties": {
        "triggers": { "$ref": "#/$defs/ruleArray" },
        "non_triggers": { "$ref": "#/$defs/ruleArray" },
        "boundaries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "description", "action"],
            "properties": {
              "code": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "action": { "enum": ["combine-or-split", "human-gate", "block"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "combination_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["with_mode_id", "status", "default_task_action", "constraint_merge"],
        "properties": {
          "with_mode_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "status": { "enum": ["compatible", "conflict"] },
          "default_task_action": { "enum": ["combine", "split-if-capabilities-span-both", "block"] },
          "constraint_merge": {
            "type": "object",
            "required": [
              "required_artifact_types", "human_decisions", "risk_rules",
              "forbidden_claims", "claim_support", "permissions", "data_boundary"
            ],
            "properties": {
              "required_artifact_types": { "const": "union" },
              "human_decisions": { "const": "union" },
              "risk_rules": { "const": "union" },
              "forbidden_claims": { "const": "union" },
              "claim_support": { "const": "per-mode-no-auto-upgrade" },
              "permissions": { "const": "take-stricter" },
              "data_boundary": { "const": "take-stricter" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "fixture_ids": {
      "type": "object",
      "required": ["trigger", "non_trigger", "boundary", "combination"],
      "properties": {
        "trigger": { "$ref": "common.schema.json#/$defs/stringArray" },
        "non_trigger": { "$ref": "common.schema.json#/$defs/stringArray" },
        "boundary": { "$ref": "common.schema.json#/$defs/stringArray" },
        "combination": { "$ref": "common.schema.json#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "change_gate": {
      "type": "object",
      "required": ["add_or_split_requires", "merge_or_delete_when"],
      "properties": {
        "add_or_split_requires": {
          "allOf": [{ "$ref": "common.schema.json#/$defs/stringArray" }, { "minItems": 1 }]
        },
        "merge_or_delete_when": {
          "allOf": [{ "$ref": "common.schema.json#/$defs/stringArray" }, { "minItems": 1 }]
        }
      },
      "additionalProperties": false
    },
    "limitations": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "$defs": {
    "evidenceBasis": {
      "enum": [
        "bounded-source-set", "computational-model-output",
        "mixed-bounded-and-computational", "other-empirical", "none", "unknown"
      ]
    },
    "ruleArray": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
