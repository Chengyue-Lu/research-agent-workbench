{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/evaluation-harness-review-policy.schema.json",
  "title": "evaluation_harness_review_policy",
  "x-rwb-document-kind": "evaluation_harness_review_policy",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "version",
    "purpose",
    "protocol_ref",
    "registered_at",
    "cases",
    "projection_rule",
    "review_unit",
    "boundaries",
    "instruction",
    "rubric"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "const": "evaluation_harness_review_policy"
    },
    "version": {
      "const": "1.0.0"
    },
    "purpose": {
      "const": "synthetic-contract-proof"
    },
    "protocol_ref": {
      "$ref": "common.schema.json#/$defs/fileRef"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "reference_integer"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reference_integer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "projection_rule": {
      "const": "synthetic-integer-v1"
    },
    "review_unit": {
      "const": "every-planned-slice-including-unstarted"
    },
    "boundaries": {
      "$ref": "evaluation-harness-execution.schema.json#/properties/boundaries"
    },
    "instruction": {
      "const": "Review the integer answer against the supplied synthetic reference."
    },
    "rubric": {
      "const": {
        "criterion": "synthetic-integer-equality",
        "choices": [
          "correct",
          "incorrect"
        ]
      }
    }
  },
  "additionalProperties": false
}
