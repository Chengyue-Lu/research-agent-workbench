{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/generic-execution-receipt.schema.json",
  "title": "Generic Execution Receipt",
  "$comment": "A file-replayable execution-only closeout for no-Skill/direct Tool M11 Core. It does not require or permit a Skill Assignment and has no Claim or Human Decision effect.",
  "x-rwb-document-kind": "generic_execution_receipt",
  "type": "object",
  "required": [
    "schema_version", "receipt_id", "attempt_id", "execution_kind", "status",
    "completion_claim", "task_ref", "view_ref", "host_report_ref", "trace_ref",
    "artifact_refs", "validation_refs", "started_at", "finished_at", "limitations", "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "receipt_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "attempt_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "execution_kind": { "enum": ["no-skill", "direct-tool", "adapter-provider"] },
    "status": { "enum": ["completed", "failed", "blocked"] },
    "completion_claim": { "enum": ["execution-only", "none"] },
    "task_ref": { "$ref": "#/$defs/revisionedFileRef" },
    "view_ref": { "$ref": "#/$defs/revisionedFileRef" },
    "host_report_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "trace_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract", "path", "sha256"],
        "properties": {
          "contract": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "validation_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/fileRef" }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "limitations": { "allOf": [{ "$ref": "common.schema.json#/$defs/stringArray" }, { "minItems": 1 }] },
    "boundaries": {
      "type": "object",
      "required": ["skill_assignment", "method_decision", "claim_effect", "human_decision", "topic5_recovery"],
      "properties": {
        "skill_assignment": { "const": "absent" },
        "method_decision": { "const": false },
        "claim_effect": { "const": false },
        "human_decision": { "const": false },
        "topic5_recovery": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completion_claim": { "const": "execution-only" },
          "artifact_refs": { "minItems": 1 }
        }
      },
      "else": {
        "properties": { "completion_claim": { "const": "none" } }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "revisionedFileRef": {
      "type": "object", "required": ["ref", "path", "sha256"],
      "properties": {
        "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@r[1-9][0-9]*$" },
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
