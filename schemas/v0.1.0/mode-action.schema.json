{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/mode-action.schema.json",
  "title": "Mode Action",
  "x-rwb-document-kind": "mode_action",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "version",
    "mode_ref",
    "title",
    "intent",
    "triggers",
    "non_triggers",
    "failure_modes",
    "required_artifacts",
    "claim_effects",
    "human_gates",
    "stop_conditions",
    "blocked_conditions"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "mode_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "intent": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "triggers": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "non_triggers": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "failure_modes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_artifacts": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "claim_effects": {
      "type": "object",
      "required": ["may_support", "cannot_alone_support", "notes"],
      "properties": {
        "may_support": { "$ref": "common.schema.json#/$defs/stringArray" },
        "cannot_alone_support": { "$ref": "common.schema.json#/$defs/stringArray" },
        "notes": { "$ref": "common.schema.json#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "human_gates": { "$ref": "common.schema.json#/$defs/stringArray" },
    "stop_conditions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "blocked_conditions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "risk_rules": { "$ref": "common.schema.json#/$defs/stringArray" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
