{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/skill-manifest.schema.json",
  "title": "Skill Manifest",
  "x-rwb-document-kind": "skill_manifest",
  "type": "object",
  "required": [
    "schema_version", "skill_id", "version", "kind", "description", "capabilities",
    "applies_to_modes", "permission_ceiling", "input_contracts", "output_contracts",
    "context_cost", "verification", "source"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "skill_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "kind": { "enum": ["method", "integrity", "tool", "output"] },
    "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "capabilities": { "$ref": "common.schema.json#/$defs/stringArray" },
    "applies_to_modes": { "$ref": "common.schema.json#/$defs/stringArray" },
    "excludes": { "$ref": "common.schema.json#/$defs/stringArray" },
    "required_tools": { "$ref": "common.schema.json#/$defs/stringArray" },
    "optional_tools": { "$ref": "common.schema.json#/$defs/stringArray" },
    "permission_ceiling": { "$ref": "common.schema.json#/$defs/permissions" },
    "input_contracts": { "$ref": "common.schema.json#/$defs/stringArray" },
    "output_contracts": { "$ref": "common.schema.json#/$defs/stringArray" },
    "context_cost": {
      "type": "object",
      "required": ["metadata", "instructions", "references"],
      "additionalProperties": { "type": "string" }
    },
    "incompatible_with": { "$ref": "common.schema.json#/$defs/stringArray" },
    "verification": {
      "type": "object",
      "required": ["deterministic"],
      "properties": {
        "deterministic": { "$ref": "common.schema.json#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["origin", "content_hash"],
      "properties": {
        "origin": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "locator": { "type": "string" },
        "content_hash": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
