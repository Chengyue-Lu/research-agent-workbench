{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/execution-binding.schema.json",
  "title": "Execution Binding",
  "$comment": "An upstream-produced exact Provider/Adapter/Model/Runtime/Host binding for one already-selected Supply. It cannot select or replace Supply.",
  "x-rwb-document-kind": "execution_binding",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "revision",
    "selected_supply_report_ref",
    "provider",
    "adapter",
    "model",
    "runtime",
    "host",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "binding_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "revision": { "type": "integer", "minimum": 1 },
    "selected_supply_report_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "provider": { "$ref": "#/$defs/componentBinding" },
    "adapter": { "$ref": "#/$defs/componentBinding" },
    "model": { "$ref": "#/$defs/componentBinding" },
    "runtime": { "$ref": "#/$defs/componentBinding" },
    "host": { "$ref": "#/$defs/componentBinding" },
    "boundaries": {
      "type": "object",
      "required": ["supply_selection", "automatic_fallback", "permission_grant", "method_decision"],
      "properties": {
        "supply_selection": { "const": false },
        "automatic_fallback": { "const": false },
        "permission_grant": { "const": false },
        "method_decision": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "componentBinding": {
      "type": "object",
      "required": ["ref", "version", "content_hash"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "version": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "content_hash": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
