{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/attempt.schema.json",
  "title": "Task Attempt",
  "x-rwb-document-kind": "attempt",
  "type": "object",
  "required": [
    "schema_version", "task_id", "task_revision", "attempt_id", "status", "started_at",
    "trigger_reason", "input_lock", "skill_lock", "artifact_refs"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "attempt_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "status": { "enum": ["planned", "running", "completed", "incomplete", "failed", "blocked", "cancelled"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "trigger_reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "input_lock": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/fileRef" } },
    "skill_lock": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "skill_assignment_ref": { "$ref": "common.schema.json#/$defs/relativePath" },
    "runtime_snapshot_ref": { "$ref": "common.schema.json#/$defs/relativePath" },
    "execution_receipt_ref": { "$ref": "common.schema.json#/$defs/relativePath" },
    "artifact_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/relativePath" },
      "uniqueItems": true
    },
    "handoff_ref": { "$ref": "common.schema.json#/$defs/relativePath" },
    "failure": { "type": "object" }
  },
  "additionalProperties": false
}
