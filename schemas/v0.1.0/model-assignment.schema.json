{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/model-assignment.schema.json",
  "title": "Model Assignment",
  "x-rwb-document-kind": "model_assignment",
  "type": "object",
  "required": [
    "schema_version", "model_assignment_id", "attempt_id", "task_id", "task_revision",
    "agent_profile_ref", "pool_id", "pool_config_hash", "slot_id", "role",
    "selection_source", "selection_reason", "provider_adapter_id", "requested_model",
    "capabilities", "reasoning_effort", "specialties", "effective_data_policy",
    "execution_limits", "automatic_fallback"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "model_assignment_id": { "type": "string", "pattern": "^MA-[0-9A-F]{16}$" },
    "attempt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "agent_profile_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "pool_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "pool_config_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "slot_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "role": { "enum": ["primary", "worker", "specialist"] },
    "selection_source": { "enum": ["profile-default", "task-override", "human-override"] },
    "selection_reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "selection_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "provider_adapter_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "requested_model": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": [
        "text", "tools", "parallel_tools", "structured_output", "streaming",
        "reasoning", "images", "files", "server_tools", "prompt_caching", "provider_state"
      ] }
    },
    "reasoning_effort": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "specialties": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
    },
    "effective_data_policy": {
      "type": "object",
      "required": [
        "local_only", "zero_data_retention_required", "training_opt_out_required",
        "allowed_regions", "allow_provider_server_tools"
      ],
      "properties": {
        "local_only": { "type": "boolean" },
        "zero_data_retention_required": { "type": "boolean" },
        "training_opt_out_required": { "type": "boolean" },
        "allowed_regions": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "allow_provider_server_tools": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "execution_limits": {
      "type": "object",
      "required": [
        "max_model_turns", "max_tool_calls", "max_parallel_tool_calls",
        "max_tool_result_chars", "max_output_tokens_per_turn", "max_seconds",
        "max_total_tokens", "max_provider_reported_cost", "allowed_tool_side_effects",
        "max_compute_values_per_call"
      ],
      "properties": {
        "max_model_turns": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_parallel_tool_calls": { "type": "integer", "minimum": 0 },
        "max_tool_result_chars": { "type": "integer", "minimum": 1 },
        "max_output_tokens_per_turn": { "type": "integer", "minimum": 1 },
        "max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_total_tokens": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "max_provider_reported_cost": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "allowed_tool_side_effects": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["none", "read-only", "local-write", "external-write"] }
        },
        "max_compute_values_per_call": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "allOf": [{
        "if": {
          "properties": { "max_tool_calls": { "minimum": 1 } },
          "required": ["max_tool_calls"]
        },
        "then": { "properties": { "max_parallel_tool_calls": { "minimum": 1 } } }
      }]
    },
    "automatic_fallback": { "const": false }
  },
  "allOf": [{
    "if": {
      "properties": { "selection_source": { "const": "profile-default" } },
      "required": ["selection_source"]
    },
    "then": { "not": { "required": ["selection_ref"] } },
    "else": { "required": ["selection_ref"] }
  }],
  "additionalProperties": false
}
