{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/release-surface-policy.schema.json",
  "title": "Append-only release surface policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "policy_id": {
      "const": "rwb-release-surface"
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "include",
          "generated"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "kind"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "file",
                    "tree"
                  ]
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "generated": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "generator",
                "version",
                "label"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "generator": {
                  "const": "rwb-release-metadata"
                },
                "version": {
                  "const": "1.0.0"
                },
                "label": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
