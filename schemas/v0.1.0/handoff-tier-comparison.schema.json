{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/handoff-tier-comparison.schema.json",
  "title": "Handoff Tier Comparison",
  "x-rwb-document-kind": "handoff_tier_comparison",
  "type": "object",
  "required": [
    "schema_version", "comparison_id", "evidence_scope", "task_ref", "input_ref",
    "outcome_criteria_ref", "arms", "declared_best_tier", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "comparison_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "evidence_scope": { "enum": ["fixture-only", "live-attempts"] },
    "task_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "input_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "outcome_criteria_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "arms": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "tier", "archive_ref", "returned_context_ref", "handoff_ref",
          "transfer_manifest_ref", "transfer_audit_ref", "artifact_refs", "metrics"
        ],
        "properties": {
          "tier": { "enum": ["H0", "H1", "H2"] },
          "archive_ref": { "oneOf": [{ "$ref": "common.schema.json#/$defs/fileRef" }, { "type": "null" }] },
          "returned_context_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
          "handoff_ref": { "oneOf": [{ "$ref": "common.schema.json#/$defs/fileRef" }, { "type": "null" }] },
          "transfer_manifest_ref": { "oneOf": [{ "$ref": "common.schema.json#/$defs/fileRef" }, { "type": "null" }] },
          "transfer_audit_ref": { "oneOf": [{ "$ref": "common.schema.json#/$defs/fileRef" }, { "type": "null" }] },
          "artifact_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/fileRef" } },
          "metrics": { "$ref": "#/$defs/metrics" }
        },
        "additionalProperties": false
      }
    },
    "declared_best_tier": { "type": ["string", "null"], "enum": ["H0", "H1", "H2", null] },
    "limitations": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "required": [
        "visible_message_count", "visible_message_chars", "archived_message_count",
        "archived_message_chars", "returned_context_chars", "artifact_count", "artifact_chars",
        "handoff_chars", "transfer_manifest_chars", "transfer_audit_chars", "generation_seconds",
        "review_seconds", "main_lookup_count", "limitation_omissions", "rework_actions",
        "read_expansion_requests", "read_expansion_grants", "new_inputs_used", "unrelated_reads",
        "capture_gap_count", "required_transfer_items", "carried_transfer_items"
      ],
      "properties": {
        "visible_message_count": { "type": "integer", "minimum": 0 },
        "visible_message_chars": { "type": "integer", "minimum": 0 },
        "archived_message_count": { "type": "integer", "minimum": 0 },
        "archived_message_chars": { "type": "integer", "minimum": 0 },
        "returned_context_chars": { "type": "integer", "minimum": 0 },
        "artifact_count": { "type": "integer", "minimum": 0 },
        "artifact_chars": { "type": "integer", "minimum": 0 },
        "handoff_chars": { "type": "integer", "minimum": 0 },
        "transfer_manifest_chars": { "type": "integer", "minimum": 0 },
        "transfer_audit_chars": { "type": "integer", "minimum": 0 },
        "generation_seconds": { "type": "number", "minimum": 0 },
        "review_seconds": { "type": "number", "minimum": 0 },
        "main_lookup_count": { "type": "integer", "minimum": 0 },
        "limitation_omissions": { "type": "integer", "minimum": 0 },
        "rework_actions": { "type": "integer", "minimum": 0 },
        "read_expansion_requests": { "type": "integer", "minimum": 0 },
        "read_expansion_grants": { "type": "integer", "minimum": 0 },
        "new_inputs_used": { "type": "integer", "minimum": 0 },
        "unrelated_reads": { "type": "integer", "minimum": 0 },
        "capture_gap_count": { "type": "integer", "minimum": 0 },
        "required_transfer_items": { "type": "integer", "minimum": 0 },
        "carried_transfer_items": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
