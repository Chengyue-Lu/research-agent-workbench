{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/evaluation-harness-review-package.schema.json",
  "title": "evaluation_harness_review_package",
  "x-rwb-document-kind": "evaluation_harness_review_package",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "version",
    "purpose",
    "instruction",
    "rubric",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "const": "evaluation_harness_review_package"
    },
    "version": {
      "const": "1.0.0"
    },
    "purpose": {
      "const": "synthetic-contract-proof"
    },
    "instruction": {
      "const": "Review the integer answer against the supplied synthetic reference."
    },
    "rubric": {
      "const": {
        "criterion": "synthetic-integer-equality",
        "choices": [
          "correct",
          "incorrect"
        ]
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "anonymous_id",
          "reference_integer",
          "answer",
          "availability"
        ],
        "properties": {
          "anonymous_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "reference_integer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "answer": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "enum": [
              "reviewable",
              "unreviewable"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "unreviewable"
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "answer": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
