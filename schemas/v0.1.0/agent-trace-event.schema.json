{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/agent-trace-event.schema.json",
  "title": "Agent Trace Event",
  "x-rwb-document-kind": "agent_trace_event",
  "type": "object",
  "required": [
    "schema_version", "event_id", "task_id", "task_revision", "attempt_id",
    "sequence", "event_type", "actor_id", "occurred_at", "payload", "redactions"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "event_id": { "type": "string", "pattern": "^EVT-[0-9]{4,}$" },
    "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "attempt_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": ["message-capture", "content-read", "tool-call", "file-revision", "external-action", "attempt-status", "capture-gap"]
    },
    "actor_id": { "$ref": "agent-trace-actors.schema.json#/$defs/actorId" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "redactions": {
      "type": "array",
      "items": { "$ref": "agent-trace-envelope.schema.json#/$defs/redaction" }
    }
  },
  "$defs": {
    "attemptStatus": {
      "enum": ["planned", "running", "completed", "stage-completed", "safe-paused", "waiting", "incomplete", "failed", "blocked", "cancelled"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "message-capture" } } },
      "then": { "properties": { "payload": {
        "type": "object", "required": ["message_id", "action"],
        "properties": {
          "message_id": { "type": "string", "pattern": "^MSG-[0-9]{4,}$" },
          "action": { "enum": ["persisted-before-send", "dispatched", "received", "persisted-before-use", "exported-delayed"] }
        }, "additionalProperties": false
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "content-read" } } },
      "then": { "properties": { "payload": {
        "type": "object", "required": ["path", "access", "allowlist_basis"],
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "access": { "enum": ["metadata-only", "content"] },
          "allowlist_basis": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }, "additionalProperties": false
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "tool-call" } } },
      "then": { "properties": { "payload": {
        "type": "object", "required": ["operation_id", "tool_name", "status", "arguments", "result_entered_context"],
        "properties": {
          "operation_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "tool_name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "status": { "enum": ["attempted", "succeeded", "failed", "cancelled", "delivered", "unknown"] },
          "arguments": { "type": "object" },
          "result_entered_context": { "type": "boolean" },
          "result_origin": { "enum": ["stable-source", "transient"] },
          "result_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
          "error_type": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "result_entered_context": { "const": true } },
              "required": ["result_entered_context"]
            },
            "then": { "required": ["result_origin"] }
          },
          {
            "if": {
              "properties": { "result_origin": { "const": "transient" } },
              "required": ["result_origin"]
            },
            "then": { "required": ["result_ref"] }
          }
        ],
        "additionalProperties": false
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "file-revision" } } },
      "then": { "properties": { "payload": {
        "type": "object", "required": ["path", "action"],
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "action": { "enum": ["created", "modified", "deleted"] },
          "old_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "new_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }, "additionalProperties": false
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "external-action" } } },
      "then": { "properties": { "payload": {
        "type": "object", "required": ["action_id", "target_category", "authorization_basis", "side_effect_status"],
        "properties": {
          "action_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "target_category": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "authorization_basis": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "side_effect_status": { "enum": ["planned", "started", "succeeded", "failed", "unknown"] },
          "receipt_ref": { "$ref": "common.schema.json#/$defs/fileRef" }
        }, "additionalProperties": false
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "attempt-status" } } },
      "then": { "properties": { "payload": {
        "type": "object", "required": ["from_status", "to_status", "reason"],
        "properties": {
          "from_status": { "$ref": "#/$defs/attemptStatus" },
          "to_status": { "$ref": "#/$defs/attemptStatus" },
          "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }, "additionalProperties": false
      } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "capture-gap" } } },
      "then": { "properties": { "payload": {
        "type": "object", "required": ["affected_stream", "reason_category", "reason"],
        "properties": {
          "affected_stream": { "enum": ["messages", "events", "tool-results", "file-revisions", "external-actions"] },
          "reason_category": { "enum": ["platform-unavailable", "truncated", "policy-omission", "capture-failure", "unknown"] },
          "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "affected_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }
        }, "additionalProperties": false
      } } }
    }
  ],
  "additionalProperties": false
}
