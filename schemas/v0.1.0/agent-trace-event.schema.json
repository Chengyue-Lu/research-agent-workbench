{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/agent-trace-event.schema.json",
  "title": "Agent Trace Event",
  "x-rwb-document-kind": "agent_trace_event",
  "type": "object",
  "required": [
    "schema_version", "event_id", "task_id", "task_revision", "attempt_id",
    "sequence", "event_type", "actor_id", "occurred_at", "payload"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "event_id": { "type": "string", "pattern": "^EVT-[0-9]{4,}$" },
    "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "attempt_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "message-capture", "content-read", "tool-call", "file-revision",
        "external-action", "attempt-status", "capture-gap"
      ]
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "message-capture" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/messageCapture" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "content-read" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/contentRead" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "tool-call" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/toolCall" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "file-revision" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/fileRevision" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "external-action" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/externalAction" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "attempt-status" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/attemptStatus" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "capture-gap" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/captureGap" } } }
    }
  ],
  "$defs": {
    "messageCapture": {
      "type": "object",
      "required": ["message_id", "action"],
      "properties": {
        "message_id": { "type": "string", "pattern": "^MSG-[0-9]{4,}$" },
        "action": {
          "enum": [
            "persisted-before-send", "dispatched", "received",
            "persisted-before-use", "exported-delayed"
          ]
        }
      },
      "additionalProperties": false
    },
    "contentRead": {
      "type": "object",
      "required": ["path", "access", "read_range", "allowlist_basis"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "access": { "enum": ["metadata-only", "content"] },
        "read_range": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "allowlist_basis": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "access": { "const": "content" } } },
          "then": { "required": ["content_sha256"] }
        }
      ],
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "required": [
        "operation_id", "tool_name", "allowlist_basis", "status", "started_at",
        "arguments", "redactions", "result_entered_context"
      ],
      "properties": {
        "operation_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "tool_name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "allowlist_basis": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "status": { "enum": ["started", "succeeded", "failed", "cancelled", "unknown"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "arguments": { "type": "object" },
        "redactions": {
          "type": "array",
          "items": { "$ref": "agent-trace-envelope.schema.json#/$defs/redaction" }
        },
        "result_entered_context": { "type": "boolean" },
        "result_origin": { "enum": ["stable-source", "transient"] },
        "result_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
        "capture_gap_event_id": { "type": "string", "pattern": "^EVT-[0-9]{4,}$" },
        "exit_code": { "type": "integer" },
        "error": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["succeeded", "failed", "cancelled"] } },
            "required": ["status"]
          },
          "then": { "required": ["finished_at"] }
        }
      ],
      "additionalProperties": false
    },
    "fileRevision": {
      "type": "object",
      "required": ["path", "action"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "action": { "enum": ["created", "modified", "deleted"] },
        "old_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "new_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "old_revision": { "type": "integer", "minimum": 1 },
        "new_revision": { "type": "integer", "minimum": 1 },
        "tombstone": {
          "type": "object",
          "required": ["reason", "accountable_owner"],
          "properties": {
            "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "accountable_owner": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "created" } } },
          "then": { "required": ["new_sha256", "new_revision"] }
        },
        {
          "if": { "properties": { "action": { "const": "modified" } } },
          "then": { "required": ["old_sha256", "old_revision", "new_sha256", "new_revision"] }
        },
        {
          "if": { "properties": { "action": { "const": "deleted" } } },
          "then": { "required": ["old_sha256", "old_revision", "tombstone"] }
        }
      ],
      "additionalProperties": false
    },
    "externalAction": {
      "type": "object",
      "required": ["action_id", "target_category", "authorization_basis", "side_effect_status"],
      "properties": {
        "action_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "target_category": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "authorization_basis": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "side_effect_status": { "enum": ["planned", "started", "succeeded", "failed", "unknown"] },
        "receipt_ref": { "$ref": "common.schema.json#/$defs/fileRef" }
      },
      "additionalProperties": false
    },
    "attemptStatus": {
      "type": "object",
      "required": ["to_status", "reason"],
      "properties": {
        "from_status": { "$ref": "#/$defs/attemptStatusValue" },
        "to_status": { "$ref": "#/$defs/attemptStatusValue" },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "attemptStatusValue": {
      "enum": [
        "planned", "running", "completed", "stage-completed", "safe-paused",
        "waiting", "incomplete", "failed", "blocked", "cancelled"
      ]
    },
    "captureGap": {
      "type": "object",
      "required": ["affected_stream", "reason_category", "reason"],
      "properties": {
        "affected_stream": {
          "enum": ["messages", "events", "tool-results", "file-revisions", "external-actions"]
        },
        "reason_category": {
          "enum": ["platform-unavailable", "truncated", "policy-omission", "capture-failure", "unknown"]
        },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "sequence_start": { "type": "integer", "minimum": 1 },
        "sequence_end": { "type": "integer", "minimum": 1 },
        "affected_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "locator_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/fileRef" }
        }
      },
      "dependentRequired": {
        "sequence_start": ["sequence_end"],
        "sequence_end": ["sequence_start"]
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
