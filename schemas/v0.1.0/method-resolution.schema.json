{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/method-resolution.schema.json",
  "x-rwb-document-kind": "method_resolution",
  "title": "Method Resolution",
  "type": "object",
  "required": [
    "schema_version", "resolution_id", "task_ref", "status", "mode_decision",
    "action_selections", "method_obligations", "mechanism_resolutions",
    "capability_requirements", "human_gates", "rejected_alternatives",
    "decision_records", "unresolved"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "resolution_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "status": { "enum": ["resolved", "human-required", "blocked", "split-required"] },
    "mode_decision": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["selected", "no-new-mode", "ambiguous-blocked"] },
        "primary_mode": { "type": ["string", "null"] },
        "unresolved_mode": { "type": "string" },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "action_selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "status"],
        "properties": {
          "action_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "status": { "enum": ["selected", "inherited", "candidate-gap"] },
          "mode_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "version": { "$ref": "common.schema.json#/$defs/semver" },
          "source_path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "selected" } } },
            "then": { "required": ["mode_id", "version", "source_path", "sha256"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "method_obligations": { "$ref": "#/$defs/objectArray" },
    "mechanism_resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "selected", "reason"],
        "properties": {
          "action_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "selected": {
            "enum": [
              "no-skill", "task-contract", "task-template", "tool-only",
              "skill-need", "human-gate", "blocked", "split-and-block"
            ]
          },
          "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "capability_requirement_refs": { "$ref": "common.schema.json#/$defs/stringArray" },
          "skill_need_refs": { "$ref": "common.schema.json#/$defs/stringArray" },
          "human_gate_refs": { "$ref": "common.schema.json#/$defs/stringArray" }
        },
        "additionalProperties": false
      }
    },
    "capability_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "capability_id", "data_egress"],
        "properties": {
          "requirement_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "capability_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "data_egress": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "status": { "enum": ["available", "gap", "blocked"] }
        },
        "additionalProperties": false
      }
    },
    "human_gates": { "$ref": "#/$defs/objectArray" },
    "rejected_alternatives": { "$ref": "#/$defs/objectArray" },
    "decision_records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["decision_type", "decided_by", "outcome", "reason"],
        "properties": {
          "decision_type": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "decided_by": { "enum": ["agent", "resolver", "human"] },
          "outcome": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    },
    "unresolved": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "$defs": {
    "objectArray": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": false
}
