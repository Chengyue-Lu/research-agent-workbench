{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/skill-evaluation.schema.json",
  "title": "Skill Evaluation",
  "x-rwb-document-kind": "skill_evaluation",
  "type": "object",
  "required": [
    "schema_version", "evaluation_id", "candidate_id", "skill_id", "skill_version",
    "skill_source_ref", "skill_package_hash", "evaluation_scope", "generated_at",
    "protocol", "cases", "admission", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "evaluation_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "candidate_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "skill_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "skill_version": { "$ref": "common.schema.json#/$defs/semver" },
    "skill_source_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "skill_package_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "project_protocol_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "model_config_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "evaluation_scope": { "enum": ["fixture-only", "live-forward-test"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "protocol": {
      "type": "object",
      "required": [
        "design", "same_provider_model_required", "blinded_review_required",
        "decision_owner", "minimum_live_cases", "required_case_kinds",
        "required_review_criteria"
      ],
      "properties": {
        "design": { "const": "paired-same-input" },
        "same_provider_model_required": { "const": true },
        "blinded_review_required": { "const": true },
        "decision_owner": { "const": "human" },
        "minimum_live_cases": { "type": "integer", "minimum": 1 },
        "required_case_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/caseKind" }
        },
        "required_review_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "admission": {
      "type": "object",
      "required": ["status", "outcome", "rationale"],
      "properties": {
        "status": { "enum": ["not-eligible", "eligible-for-human-decision", "human-decided"] },
        "outcome": { "enum": ["pending", "accept", "revise", "reject"] },
        "decision_ref": { "$ref": "common.schema.json#/$defs/relativePath" },
        "rationale": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "human-decided" } }, "required": ["status"] },
          "then": {
            "required": ["decision_ref"],
            "properties": { "outcome": { "enum": ["accept", "revise", "reject"] } }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["not-eligible", "eligible-for-human-decision"] } }, "required": ["status"] },
          "then": { "properties": { "outcome": { "const": "pending" } } }
        }
      ],
      "additionalProperties": false
    },
    "limitations": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evaluation_scope": { "const": "live-forward-test" } },
        "required": ["evaluation_scope"]
      },
      "then": { "required": ["project_protocol_ref", "model_config_ref"] }
    }
  ],
  "$defs": {
    "caseKind": {
      "enum": ["trigger", "non-trigger", "missing-input", "adversarial", "boundary", "regression", "routing"]
    },
    "contextMeasurement": {
      "type": "object",
      "required": ["status", "task_input_characters", "skill_instruction_characters", "total_loaded_characters"],
      "properties": {
        "status": { "enum": ["measured", "estimated", "unavailable"] },
        "task_input_characters": { "type": "integer", "minimum": 0 },
        "skill_instruction_characters": { "type": "integer", "minimum": 0 },
        "total_loaded_characters": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "arm": {
      "type": "object",
      "required": [
        "skill_loaded", "output_ref", "validation_ref", "deterministic_status", "context"
      ],
      "properties": {
        "skill_loaded": { "type": "boolean" },
        "output_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
        "validation_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
        "deterministic_status": { "enum": ["pass", "fail", "not-run"] },
        "execution_receipt_ref": { "$ref": "common.schema.json#/$defs/relativePath" },
        "provider": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "model": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "model_config_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "context": { "$ref": "#/$defs/contextMeasurement" }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["criterion_id", "baseline_score", "with_skill_score", "scale"],
      "properties": {
        "criterion_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "baseline_score": { "type": "integer", "minimum": 0, "maximum": 4 },
        "with_skill_score": { "type": "integer", "minimum": 0, "maximum": 4 },
        "scale": { "const": "0-worst-to-4-best" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "status", "reviewer_kind", "reviewer_independent", "blinded",
        "order_revealed_after_scoring", "label_order", "preference", "criteria",
        "limitations"
      ],
      "properties": {
        "status": { "enum": ["pending", "completed"] },
        "reviewer_kind": { "enum": ["none", "human", "model", "mixed"] },
        "reviewer_independent": { "type": "boolean" },
        "blinded": { "type": "boolean" },
        "order_revealed_after_scoring": { "type": "boolean" },
        "scored_at": { "type": "string", "format": "date-time" },
        "revealed_at": { "type": "string", "format": "date-time" },
        "label_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["baseline", "with-skill"] }
        },
        "preference": { "enum": ["pending", "baseline", "with-skill", "tie", "undecidable"] },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        },
        "baseline_substantive_errors": { "type": "integer", "minimum": 0 },
        "with_skill_substantive_errors": { "type": "integer", "minimum": 0 },
        "baseline_correction_minutes": { "type": "number", "minimum": 0 },
        "with_skill_correction_minutes": { "type": "number", "minimum": 0 },
        "limitations": { "$ref": "common.schema.json#/$defs/stringArray" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "required": ["scored_at", "revealed_at"] }
        }
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "case_kind", "task_contract_ref", "input_ref", "arms", "review"],
      "properties": {
        "case_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "case_kind": { "$ref": "#/$defs/caseKind" },
        "task_contract_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
        "input_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
        "arms": {
          "type": "object",
          "required": ["baseline", "with_skill"],
          "properties": {
            "baseline": {
              "allOf": [
                { "$ref": "#/$defs/arm" },
                { "properties": { "skill_loaded": { "const": false } } }
              ]
            },
            "with_skill": {
              "allOf": [
                { "$ref": "#/$defs/arm" },
                { "properties": { "skill_loaded": { "const": true } } }
              ]
            }
          },
          "additionalProperties": false
        },
        "review": { "$ref": "#/$defs/review" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
