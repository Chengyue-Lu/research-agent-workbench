{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/provider-adapters-v2.schema.json",
  "title": "Provider Adapters V2",
  "x-rwb-document-kind": "provider_adapters",
  "$comment": "Closed ProviderAdapterConfigV2@2.0.0 candidate; disabled adapters receive the same structural validation. Runtime additionally rejects duplicate adapter_id values, conflicting FileRefs, unsupported credential backends, profile/vendor/model/mode combinations and capability gaps before credential access. os-vault is format-only and cannot execute without an explicitly implemented backend.",
  "type": "object",
  "required": [
    "schema_version",
    "registry_kind",
    "config_version",
    "config_id",
    "adapters"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "registry_kind": {
      "const": "provider_adapters"
    },
    "config_version": {
      "const": "2.0.0"
    },
    "config_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/adapter"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$(?![\\s\\S])"
    },
    "portableRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$(?![\\s\\S])",
      "allOf": [
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "\\.(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]+)?(?:/|$)"
          }
        }
      ]
    },
    "fileRef": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portableRelativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$(?![\\s\\S])"
    },
    "adapter": {
      "type": "object",
      "required": [
        "adapter_id",
        "enabled",
        "profile_ref",
        "model_selector",
        "credential_source",
        "capabilities",
        "transport",
        "conformance_ref"
      ],
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "enabled": {
          "type": "boolean"
        },
        "profile_ref": {
          "$ref": "#/$defs/fileRef"
        },
        "model_selector": {
          "$ref": "#/$defs/modelSelector"
        },
        "credential_source": {
          "$ref": "#/$defs/credentialSource"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "tools",
              "structured_output",
              "parallel_tools"
            ]
          },
          "uniqueItems": true
        },
        "transport": {
          "$ref": "#/$defs/transport"
        },
        "conformance_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/fileRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "modelSelector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "environment"
            },
            "value": {
              "$ref": "#/$defs/environmentName"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "credentialSource": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "environment"
            },
            "name": {
              "$ref": "#/$defs/environmentName"
            }
          },
          "additionalProperties": false
        },
        {
          "$comment": "Reserved format candidate only. Runtime must reject os-vault before credential availability/resolution until an implemented and frozen backend is accepted.",
          "type": "object",
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "const": "os-vault"
            },
            "reference": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "transport": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "max_response_bytes",
        "redirect_policy",
        "retry_policy"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "redirect_policy": {
          "const": "deny"
        },
        "retry_policy": {
          "const": "none"
        }
      },
      "additionalProperties": false
    }
  }
}
