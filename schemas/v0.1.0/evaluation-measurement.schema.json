{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/evaluation-measurement.schema.json",
  "title": "Evaluation Measurement",
  "x-rwb-document-kind": "evaluation_measurement",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "measurement_id",
    "version",
    "protocol_ref",
    "case_id",
    "arm_id",
    "metric_id",
    "status",
    "unit",
    "value",
    "reason",
    "evidence_refs",
    "estimation_method",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "const": "evaluation_measurement"
    },
    "measurement_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1.0.0"
    },
    "protocol_ref": {
      "$ref": "common.schema.json#/$defs/fileRef"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "arm_id": {
      "enum": [
        "plain-agent",
        "plain-agent-tool",
        "mode-no-skill",
        "mode-candidate-skill"
      ]
    },
    "metric_id": {
      "enum": [
        "method-violation",
        "claim-overreach",
        "provenance-error",
        "counterevidence-omission",
        "human-correction-distance",
        "omission-rate",
        "rework-count",
        "lookup-count",
        "h2-distortion-rate",
        "cascade-rate",
        "context-loaded",
        "cost",
        "completion-time"
      ]
    },
    "status": {
      "enum": [
        "measured",
        "estimated",
        "unavailable",
        "not-applicable"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/fileRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "estimation_method": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "boundaries": {
      "const": {
        "runtime_input": false,
        "execution_authority": false,
        "supply_selection": false,
        "human_decision": false,
        "claim_acceptance": false,
        "promotion": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "measured",
              "estimated"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "estimated"
          }
        }
      },
      "then": {
        "properties": {
          "estimation_method": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "estimation_method": {
            "const": null
          }
        }
      }
    }
  ]
}
