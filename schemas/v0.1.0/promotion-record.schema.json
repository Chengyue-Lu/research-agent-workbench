{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/promotion-record.schema.json",
  "title": "Artifact Promotion Record",
  "x-rwb-document-kind": "promotion_record",
  "type": "object",
  "required": [
    "schema_version", "promotion_id", "source_workspace", "validation_report",
    "validation_policy", "validation_execution", "operator", "recorded_at",
    "entries", "authority_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "promotion_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_workspace": { "$ref": "common.schema.json#/$defs/relativePath" },
    "validation_report": { "$ref": "common.schema.json#/$defs/fileRef" },
    "validation_policy": { "$ref": "common.schema.json#/$defs/fileRef" },
    "validation_execution": { "$ref": "common.schema.json#/$defs/fileRef" },
    "operator": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact", "disposition", "negative_result"],
        "properties": {
          "artifact": { "$ref": "common.schema.json#/$defs/fileRef" },
          "disposition": { "enum": ["promote", "retain-in-work"] },
          "negative_result": { "type": "boolean" },
          "target": { "$ref": "common.schema.json#/$defs/relativePath" },
          "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "disposition": { "const": "promote" } },
              "required": ["disposition"]
            },
            "then": { "required": ["target"] }
          },
          {
            "if": {
              "properties": { "disposition": { "const": "retain-in-work" } },
              "required": ["disposition"]
            },
            "then": {
              "required": ["reason"],
              "not": { "required": ["target"] }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "authority_boundaries": {
      "type": "object",
      "required": [
        "structural_eligibility_only", "claim_acceptance", "human_decision",
        "publication", "source_deletion"
      ],
      "properties": {
        "structural_eligibility_only": { "const": true },
        "claim_acceptance": { "const": false },
        "human_decision": { "const": false },
        "publication": { "const": false },
        "source_deletion": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
