{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/promotion-record.schema.json",
  "title": "Promotion Record",
  "x-rwb-document-kind": "promotion_record",
  "type": "object",
  "required": [
    "schema_version",
    "promotion_id",
    "source_workspace",
    "validation_report",
    "decided_by",
    "decided_at",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "promotion_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "source_workspace": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/relativePath" },
        { "pattern": "(^|/)work/.+" }
      ]
    },
    "validation_report": { "$ref": "common.schema.json#/$defs/fileRef" },
    "decided_by": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "decided_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact", "disposition", "negative_result"],
        "properties": {
          "artifact": { "$ref": "common.schema.json#/$defs/fileRef" },
          "disposition": { "enum": ["promoted", "retained-in-work"] },
          "negative_result": { "type": "boolean" },
          "target": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/relativePath" },
              { "pattern": "(^|/)(objects|runs|deliverables)/.+" }
            ]
          },
          "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "promoted" } }, "required": ["disposition"] },
            "then": { "required": ["target"] }
          },
          {
            "if": { "properties": { "negative_result": { "const": true } }, "required": ["negative_result"] },
            "then": { "required": ["reason"] }
          },
          {
            "if": { "properties": { "disposition": { "const": "retained-in-work" } }, "required": ["disposition"] },
            "then": { "required": ["reason"] }
          }
        ]
      }
    },
    "limitations": { "$ref": "common.schema.json#/$defs/stringArray" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
