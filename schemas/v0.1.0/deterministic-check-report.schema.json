{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/deterministic-check-report.schema.json",
  "title": "Deterministic Check Report",
  "x-rwb-document-kind": "deterministic_check_report",
  "type": "object",
  "required": [
    "schema_version", "report_id", "checker", "subject_refs", "status",
    "checks", "scope", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "report_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "checker": {
      "type": "object",
      "required": ["checker_id", "version", "source_ref"],
      "properties": {
        "checker_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "version": { "$ref": "common.schema.json#/$defs/semver" },
        "source_ref": { "$ref": "common.schema.json#/$defs/fileRef" }
      },
      "additionalProperties": false
    },
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/fileRef" }
    },
    "status": { "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "status", "detail"],
        "properties": {
          "code": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "status": { "enum": ["pass", "fail"] },
          "detail": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    },
    "scope": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "limitations": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checks": {
            "not": { "contains": { "properties": { "status": { "const": "fail" } }, "required": ["status"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "fail" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checks": {
            "contains": { "properties": { "status": { "const": "fail" } }, "required": ["status"] }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
