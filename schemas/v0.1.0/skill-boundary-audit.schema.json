{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/skill-boundary-audit.schema.json",
  "title": "Accepted Skill Boundary Audit",
  "x-rwb-document-kind": "skill_boundary_audit",
  "type": "object",
  "required": [
    "schema_version", "audit_id", "skill_lock", "outcome", "selection_policy",
    "trigger_fixture_ids", "boundary_fixture_ids", "non_trigger_fixture_ids",
    "manifest_changes", "deletion_conditions", "evidence_refs", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "audit_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "skill_lock": {
      "type": "object",
      "required": ["skill_id", "version", "manifest_hash", "content_hash", "package_hash"],
      "properties": {
        "skill_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "version": { "$ref": "common.schema.json#/$defs/semver" },
        "manifest_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "content_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "package_hash": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "outcome": { "enum": ["retain", "retain-with-boundary-fix", "retain-deterministic-first", "deprecate", "retire"] },
    "selection_policy": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "trigger_fixture_ids": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/stringArray" }, { "minItems": 1 }]
    },
    "boundary_fixture_ids": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/stringArray" }, { "minItems": 1 }]
    },
    "non_trigger_fixture_ids": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/stringArray" }, { "minItems": 1 }]
    },
    "manifest_changes": { "$ref": "common.schema.json#/$defs/stringArray" },
    "deletion_conditions": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/stringArray" }, { "minItems": 1 }]
    },
    "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/fileRef" } },
    "limitations": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "additionalProperties": false
}
