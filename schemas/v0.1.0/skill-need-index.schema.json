{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/skill-need-index.schema.json",
  "title": "Skill Need Integrity Index",
  "$comment": "A closed immutable reference/path/hash index. It is not a candidate, admission, evaluation-result, runtime-eligibility, availability, or routing registry.",
  "x-rwb-document-kind": "skill_need_index",
  "type": "object",
  "required": ["schema_version", "registry_kind", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "registry_kind": { "const": "skill_need_index" },
    "generated_at": { "type": "string", "format": "date" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["need_ref", "need_id", "version", "document_path", "content_hash"],
        "properties": {
          "need_ref": {
            "type": "string",
            "pattern": "^NEED-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "need_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": { "$ref": "common.schema.json#/$defs/semver" },
          "document_path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "content_hash": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
