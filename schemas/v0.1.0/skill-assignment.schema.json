{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/skill-assignment.schema.json",
  "title": "Skill Assignment",
  "x-rwb-document-kind": "skill_assignment",
  "type": "object",
  "required": [
    "schema_version", "assignment_id", "task_id", "task_revision", "agent_profile",
    "skill_lock", "resolved_tools", "effective_permissions", "output_contracts", "resolution_reason"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "assignment_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "agent_profile": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "skill_lock": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["skill_id", "version", "content_hash"],
        "properties": {
          "skill_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "version": { "$ref": "common.schema.json#/$defs/semver" },
          "content_hash": { "$ref": "common.schema.json#/$defs/sha256" },
          "source_locator": { "$ref": "common.schema.json#/$defs/relativePath" },
          "package_hash": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "resolved_tools": { "$ref": "common.schema.json#/$defs/stringArray" },
    "effective_permissions": { "$ref": "common.schema.json#/$defs/permissions" },
    "output_contracts": { "$ref": "common.schema.json#/$defs/stringArray" },
    "resolution_reason": { "$ref": "common.schema.json#/$defs/stringArray" },
    "registry_digest": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
