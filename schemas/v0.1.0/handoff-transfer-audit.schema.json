{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/handoff-transfer-audit.schema.json",
  "title": "Handoff Transfer Audit",
  "x-rwb-document-kind": "handoff_transfer_audit",
  "type": "object",
  "required": [
    "schema_version", "audit_id", "task_ref", "handoff_ref", "manifest_ref",
    "generated_at", "mappings", "review", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "audit_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "handoff_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "manifest_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "generated_at": { "type": "string", "format": "date-time" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "status"],
        "properties": {
          "item_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "status": { "enum": ["carried", "omitted-with-reason"] },
          "handoff_locator": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "omission_reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "carried" } }, "required": ["status"] },
            "then": { "required": ["handoff_locator"], "not": { "required": ["omission_reason"] } }
          },
          {
            "if": { "properties": { "status": { "const": "omitted-with-reason" } }, "required": ["status"] },
            "then": { "required": ["omission_reason"], "not": { "required": ["handoff_locator"] } }
          }
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status", "reviewer_kind", "reviewer_independent", "sampled_item_ids", "findings"
      ],
      "properties": {
        "status": { "enum": ["pending", "completed"] },
        "reviewer_kind": { "enum": ["none", "human", "model", "mixed"] },
        "reviewer_independent": { "type": "boolean" },
        "sampled_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_id", "status", "detail"],
            "properties": {
              "item_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "status": { "enum": ["preserved", "distorted", "unverifiable"] },
              "detail": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
            },
            "additionalProperties": false
          }
        },
        "reviewed_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "required": ["reviewed_at"] }
        }
      ],
      "additionalProperties": false
    },
    "limitations": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "additionalProperties": false
}
