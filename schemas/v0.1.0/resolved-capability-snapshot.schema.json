{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/resolved-capability-snapshot.schema.json",
  "title": "Resolved Capability Snapshot",
  "$comment": "A hash-pinned structural replay record or qualified frozen supply record. It preserves selected supply facts and never grants final execution permission, routes, falls back, or alters Method, Claim, Gate, or Human authority.",
  "x-rwb-document-kind": "resolved_capability_snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "revision",
    "qualification",
    "task_ref",
    "resolution_ref",
    "method_resolution_ref",
    "requirement_ref",
    "selected_supply_report_ref",
    "supply_identity",
    "supply_required_permissions",
    "supply_data_egress",
    "supply_side_effects",
    "conformance_evidence_refs",
    "limitations",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "snapshot_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "revision": { "type": "integer", "minimum": 1 },
    "qualification": { "enum": ["structural-replay", "runtime-execution"] },
    "task_ref": { "$ref": "#/$defs/revisionedRef" },
    "resolution_ref": { "$ref": "#/$defs/revisionedRef" },
    "method_resolution_ref": { "$ref": "#/$defs/revisionedRef" },
    "requirement_ref": { "$ref": "capability-supply-common.schema.json#/$defs/requirementRef" },
    "selected_supply_report_ref": { "$ref": "capability-supply-common.schema.json#/$defs/versionedDocumentRef" },
    "supply_identity": { "$ref": "capability-supply-common.schema.json#/$defs/supplyIdentity" },
    "supply_required_permissions": {
      "$ref": "capability-supply-common.schema.json#/$defs/permissionBoundary"
    },
    "supply_data_egress": {
      "$ref": "capability-supply-common.schema.json#/$defs/dataEgressBoundary"
    },
    "supply_side_effects": {
      "$ref": "capability-supply-common.schema.json#/$defs/sideEffectBoundary"
    },
    "conformance_evidence_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/fileRef" },
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "boundaries": {
      "type": "object",
      "required": ["execution_input", "method_decision", "permission_grant", "claim_effect", "human_decision", "fallback_authority"],
      "properties": {
        "execution_input": { "type": "boolean" },
        "method_decision": { "const": false },
        "permission_grant": { "const": false },
        "claim_effect": { "const": false },
        "human_decision": { "const": false },
        "fallback_authority": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "qualification": { "const": "structural-replay" } }, "required": ["qualification"] },
      "then": {
        "properties": {
          "boundaries": { "properties": { "execution_input": { "const": false } } }
        }
      },
      "else": {
        "properties": {
          "boundaries": { "properties": { "execution_input": { "const": true } } }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "revisionedRef": {
      "allOf": [
        { "$ref": "capability-supply-common.schema.json#/$defs/versionedDocumentRef" },
        {
          "properties": {
            "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@r[1-9][0-9]*$" }
          }
        }
      ]
    }
  }
}
