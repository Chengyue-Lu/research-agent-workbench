{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Execution Consumption 1.0.0",
  "x-rwb-document-kind": "skill_execution_consumption",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "supply_report_ref",
    "projection_ref",
    "skill",
    "component",
    "record_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "supply_report_ref": {
      "type": "object",
      "required": [
        "ref",
        "path",
        "sha256"
      ],
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "projection_ref": {
      "type": "object",
      "required": [
        "ref",
        "path",
        "sha256"
      ],
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": [
        "skill_id",
        "skill_version",
        "content_hash"
      ],
      "properties": {
        "skill_id": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "skill_version": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "content_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "component_kind",
        "component_ref",
        "version",
        "content_hash"
      ],
      "properties": {
        "component_kind": {
          "const": "skill"
        },
        "component_ref": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "content_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "record_kind": {
      "const": "skill_execution_consumption"
    }
  },
  "additionalProperties": false,
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/skill-execution-consumption.schema.json"
}
