{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/agent-trace-index.schema.json",
  "title": "Agent Trace Index",
  "x-rwb-document-kind": "agent_trace_index",
  "type": "object",
  "required": [
    "schema_version", "trace_id", "task_id", "attempt_id", "accountable_owner",
    "generated_at", "event_ledger_ref", "events", "messages",
    "capture_gap_event_ids", "handoff_refs", "decision_refs"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "trace_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "attempt_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "accountable_owner": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "generated_at": { "type": "string", "format": "date-time" },
    "event_ledger_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "sequence", "event_type", "actor_id", "occurred_at", "status"],
        "properties": {
          "event_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sequence": { "type": "integer", "minimum": 1 },
          "event_type": { "$ref": "agent-trace-event.schema.json#/$defs/eventType" },
          "actor_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "occurred_at": { "type": "string", "format": "date-time" },
          "status": { "$ref": "agent-trace-event.schema.json#/$defs/eventStatus" }
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message_id", "sequence", "kind", "sender_actor_id", "receiver_actor_ids",
          "accountable_owner", "created_at", "capture_status", "content_ref",
          "attachment_refs", "sent_event_id", "received_event_ids"
        ],
        "properties": {
          "message_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sequence": { "type": "integer", "minimum": 1 },
          "kind": {
            "enum": [
              "assignment", "clarification", "scope-request", "scope-decision",
              "progress", "handoff", "review", "decision", "acknowledgement",
              "failure", "cancellation", "safe-pause"
            ]
          },
          "sender_actor_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "receiver_actor_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "uniqueItems": true
          },
          "accountable_owner": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "created_at": { "type": "string", "format": "date-time" },
          "capture_status": { "enum": ["complete", "delayed", "redacted", "omitted", "gap"] },
          "content_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
          "attachment_refs": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/fileRef" }
          },
          "sent_event_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "received_event_ids": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "uniqueItems": true
          },
          "handoff_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
          "decision_ref": { "$ref": "common.schema.json#/$defs/fileRef" }
        },
        "additionalProperties": false
      }
    },
    "capture_gap_event_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "handoff_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/fileRef" }
    },
    "decision_refs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/fileRef" }
    }
  },
  "additionalProperties": false
}
