{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/runtime-bundle-manifest.schema.json",
  "title": "Runtime Bundle Manifest",
  "$comment": "An explicit, hash-pinned allowlist of the exact frozen documents a Runtime bundle validator may read. It does not select Supply or grant execution permission.",
  "x-rwb-document-kind": "runtime_bundle_manifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "revision",
    "profile",
    "execution_scope",
    "entrypoint",
    "documents",
    "imports",
    "skill_extension",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "bundle_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "profile": { "const": "runtime-bundle" },
    "execution_scope": {
      "type": "object",
      "required": [
        "kind", "action_ref", "requirement_id", "task_capability_closure"
      ],
      "properties": {
        "kind": { "const": "action-capability-slice" },
        "action_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "requirement_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "task_capability_closure": {
          "type": "object",
          "required": ["required", "closed", "task_completion"],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
            },
            "closed": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
            },
            "task_completion": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entrypoint": {
      "allOf": [
        { "$ref": "#/$defs/documentRef" },
        { "properties": { "kind": { "const": "resolved_capability_snapshot" } } }
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/documentRef" }
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/importEdge" }
    },
    "skill_extension": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "projection": {
          "allOf": [
            { "$ref": "#/$defs/documentRef" },
            { "properties": { "kind": { "const": "skill_release_projection" } } }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "required": ["projection"] },
          "else": { "not": { "required": ["projection"] } }
        }
      ],
      "additionalProperties": false
    },
    "boundaries": {
      "type": "object",
      "required": ["supply_selection", "execution_authority", "permission_grant", "fallback_authority"],
      "properties": {
        "supply_selection": { "const": false },
        "execution_authority": { "const": false },
        "permission_grant": { "const": false },
        "fallback_authority": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "documentRef": {
      "type": "object",
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "task_packet",
            "method_resolution",
            "capability_requirement",
            "capability_conformance_evidence",
            "capability_supply_report",
            "capability_resolution",
            "resolved_capability_snapshot",
            "skill_release_projection"
          ]
        },
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "importEdge": {
      "type": "object",
      "required": ["from_path", "to_path", "relation"],
      "properties": {
        "from_path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "to_path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "relation": {
          "enum": [
            "snapshot-task",
            "snapshot-method",
            "snapshot-requirement",
            "snapshot-resolution",
            "snapshot-supply",
            "snapshot-conformance",
            "method-task",
            "resolution-method",
            "resolution-requirement",
            "resolution-candidate-supply",
            "supply-conformance",
            "supply-projection"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
