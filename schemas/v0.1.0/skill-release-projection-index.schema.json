{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/skill-release-projection-index.schema.json",
  "title": "Skill Release Projection integrity index",
  "x-rwb-document-kind": "skill_release_projection_index",
  "type": "object",
  "required": ["schema_version", "registry_kind", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "registry_kind": { "const": "skill_release_projection_index" },
    "generated_at": { "type": "string", "format": "date" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "projection_ref",
          "projection_id",
          "projection_version",
          "release_ref",
          "document_path",
          "content_hash"
        ],
        "properties": {
          "projection_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "projection_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "projection_version": { "$ref": "common.schema.json#/$defs/semver" },
          "release_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "document_path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "content_hash": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
