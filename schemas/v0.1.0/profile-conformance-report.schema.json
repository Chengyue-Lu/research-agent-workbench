{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/profile-conformance-report.schema.json",
  "title": "Profile Conformance Report",
  "x-rwb-document-kind": "profile_conformance_report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "report_version",
    "status",
    "stop_code",
    "provider",
    "profile_id",
    "requested_model",
    "observed_models",
    "profile_ref",
    "config_ref",
    "source_refs",
    "limits",
    "calls",
    "actual_counts",
    "assertions",
    "accounting",
    "remote_strict_claim",
    "live_qualified",
    "qualification",
    "http_observation",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "const": "profile_conformance_report"
    },
    "report_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "blocked"
      ]
    },
    "stop_code": {
      "enum": [
        "completed",
        "plan-blocked",
        "input-bounds-required",
        "journal-blocked",
        "attempt-admission-refused",
        "provider-construction-refused",
        "guard-refused",
        "deadline-exhausted",
        "transport-binding-drift",
        "transport-protocol-failed",
        "provider-invocation-failed",
        "accounting-failed",
        "session-failed",
        "capture-gap",
        "tool-shape-failed",
        "text-assertion-failed",
        "schema-assertion-failed",
        "unknown-token-usage"
      ]
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "google",
        "deepseek",
        "alibaba",
        "zhipu",
        "moonshot",
        "minimax",
        "siliconflow",
        "bytedance",
        "openrouter"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "observed_models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 3
    },
    "profile_ref": {
      "$ref": "common.schema.json#/$defs/fileRef"
    },
    "config_ref": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/fileRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "source_sha256"
        ],
        "properties": {
          "module": {
            "enum": [
              "research_workbench.adapters.models.profile_conformance",
              "research_workbench.adapters.models.conformance_transport"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "module": {
                "const": "research_workbench.adapters.models.profile_conformance"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "module": {
                "const": "research_workbench.adapters.models.conformance_transport"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_provider_invocations",
        "max_tool_executions",
        "max_output_tokens",
        "max_seconds"
      ],
      "properties": {
        "max_provider_invocations": {
          "const": 3
        },
        "max_tool_executions": {
          "const": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 16,
          "maximum": 256
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "phase",
          "finish_reason",
          "response_received",
          "assertion_passed",
          "input_tokens",
          "output_tokens",
          "cached_input_tokens",
          "reasoning_tokens"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "phase": {
            "enum": [
              "specific-tool",
              "result-text",
              "structured"
            ]
          },
          "finish_reason": {
            "enum": [
              null,
              "complete",
              "tool_call",
              "length",
              "stop",
              "refusal",
              "paused",
              "context_limit",
              "error",
              "unknown"
            ]
          },
          "response_received": {
            "type": "boolean"
          },
          "assertion_passed": {
            "type": "boolean"
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "cached_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "reasoning_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      },
      "maxItems": 3
    },
    "actual_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_invocations",
        "http_entry_observations",
        "tool_executions",
        "responses_received"
      ],
      "properties": {
        "provider_invocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "http_entry_observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "tool_executions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "responses_received": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_shape",
        "tool_executed_once",
        "text_exact",
        "schema_exact"
      ],
      "properties": {
        "tool_call_shape": {
          "type": "boolean"
        },
        "tool_executed_once": {
          "type": "boolean"
        },
        "text_exact": {
          "type": "boolean"
        },
        "schema_exact": {
          "type": "boolean"
        }
      }
    },
    "accounting": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ledger_version",
            "journal_version",
            "scope",
            "limits",
            "blocked",
            "blocked_reason",
            "provider_invocations",
            "http_send_attempts",
            "responses_received",
            "successful_responses",
            "failed_invocations",
            "known_input_tokens",
            "known_output_tokens",
            "known_total_tokens",
            "unresolved_reserved_tokens",
            "remaining_token_capacity",
            "cost",
            "attempts",
            "calls",
            "durable_send_intents",
            "http_entry_observations",
            "events_committed",
            "recovery_required",
            "budget_namespace"
          ],
          "properties": {
            "ledger_version": {
              "const": "1.0.0"
            },
            "journal_version": {
              "const": "1.0.0"
            },
            "scope": {
              "const": "durable-caller-attested"
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total_token_limit",
                "max_attempts",
                "max_invocations_per_attempt",
                "max_output_tokens_per_invocation"
              ],
              "properties": {
                "total_token_limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "max_attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "max_invocations_per_attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "max_output_tokens_per_invocation": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                }
              }
            },
            "blocked": {
              "type": "boolean"
            },
            "blocked_reason": {
              "enum": [
                null,
                "total-token-limit-exceeded",
                "reservation-exceeded",
                "unresolved-accounting",
                "uncertain-http-outcome",
                "pending-reservation"
              ]
            },
            "provider_invocations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "http_send_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "responses_received": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "successful_responses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "failed_invocations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "known_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "known_output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "known_total_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "unresolved_reserved_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "remaining_token_capacity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "cost": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "requirement",
                "provider_reported_cost",
                "currency",
                "estimated_cost_computed",
                "billing_settlement_verified"
              ],
              "properties": {
                "status": {
                  "const": "unknown"
                },
                "requirement": {
                  "const": "not-required"
                },
                "provider_reported_cost": {
                  "type": "null"
                },
                "currency": {
                  "type": "null"
                },
                "estimated_cost_computed": {
                  "const": false
                },
                "billing_settlement_verified": {
                  "const": false
                }
              }
            },
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ordinal",
                  "status",
                  "provider_invocations",
                  "repair_refreeze_asserted"
                ],
                "properties": {
                  "ordinal": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "status": {
                    "enum": [
                      "open",
                      "failed",
                      "completed"
                    ]
                  },
                  "provider_invocations": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "repair_refreeze_asserted": {
                    "type": "boolean"
                  }
                }
              },
              "maxItems": 3
            },
            "calls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ordinal",
                  "attempt_ordinal",
                  "input_upper_tokens",
                  "output_upper_tokens",
                  "send_attempted",
                  "settled",
                  "response_received",
                  "successful_reported",
                  "outcome",
                  "accounting_status",
                  "reported_usage",
                  "verified_usage",
                  "send_intent_durable",
                  "http_entry_observed",
                  "may_have_sent",
                  "token_usage_failure"
                ],
                "properties": {
                  "ordinal": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9
                  },
                  "attempt_ordinal": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "input_upper_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "output_upper_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  "send_attempted": {
                    "type": "boolean"
                  },
                  "settled": {
                    "type": "boolean"
                  },
                  "response_received": {
                    "type": "boolean"
                  },
                  "successful_reported": {
                    "type": "boolean"
                  },
                  "outcome": {
                    "enum": [
                      "reserved",
                      "succeeded",
                      "failed",
                      "failed-before-send"
                    ]
                  },
                  "accounting_status": {
                    "enum": [
                      "reserved",
                      "known",
                      "unresolved",
                      "released-before-send",
                      "reservation-exceeded",
                      "total-limit-exceeded"
                    ]
                  },
                  "reported_usage": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "input_tokens",
                          "output_tokens",
                          "cached_input_tokens",
                          "reasoning_tokens",
                          "provider_reported_cost",
                          "currency",
                          "cost_status"
                        ],
                        "properties": {
                          "input_tokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "output_tokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "cached_input_tokens": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "reasoning_tokens": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "provider_reported_cost": {
                            "type": "null"
                          },
                          "currency": {
                            "type": "null"
                          },
                          "cost_status": {
                            "const": "unknown"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "verified_usage": {
                    "type": "null"
                  },
                  "send_intent_durable": {
                    "type": "boolean"
                  },
                  "http_entry_observed": {
                    "type": "boolean"
                  },
                  "may_have_sent": {
                    "type": "boolean"
                  },
                  "token_usage_failure": {
                    "enum": [
                      null,
                      "usage-unavailable",
                      "invalid-token-usage",
                      "invalid-token-subset"
                    ]
                  }
                }
              },
              "maxItems": 9
            },
            "durable_send_intents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "http_entry_observations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "events_committed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "recovery_required": {
              "type": "boolean"
            },
            "budget_namespace": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "remote_strict_claim": {
      "const": false
    },
    "live_qualified": {
      "const": false
    },
    "qualification": {
      "const": "external-accepted-run-gates-required"
    },
    "http_observation": {
      "const": "delegate-entry-only-not-socket-proof"
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "caller-attested-gates",
          "partial-source-closure",
          "input-bound-proof-unverified",
          "windows-run-unaccepted",
          "remote-strict-unclaimed",
          "capture-gap"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "stop_code": {
            "const": "completed"
          },
          "assertions": {
            "properties": {
              "tool_call_shape": {
                "const": true
              },
              "tool_executed_once": {
                "const": true
              },
              "text_exact": {
                "const": true
              },
              "schema_exact": {
                "const": true
              }
            }
          },
          "actual_counts": {
            "properties": {
              "provider_invocations": {
                "const": 3
              },
              "http_entry_observations": {
                "const": 3
              },
              "responses_received": {
                "const": 3
              },
              "tool_executions": {
                "const": 1
              }
            }
          },
          "calls": {
            "minItems": 3,
            "items": {
              "properties": {
                "assertion_passed": {
                  "const": true
                },
                "response_received": {
                  "const": true
                },
                "input_tokens": {
                  "type": "integer"
                },
                "output_tokens": {
                  "type": "integer"
                }
              }
            }
          },
          "accounting": {
            "type": "object",
            "properties": {
              "blocked": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "stop_code": {
            "not": {
              "const": "completed"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accounting": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "blocked"
          },
          "stop_code": {
            "const": "accounting-failed"
          }
        }
      }
    }
  ]
}
