{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/capability-conformance-evidence.schema.json",
  "title": "Synthetic Capability Conformance Evidence",
  "$comment": "A content-addressed fixture record. Synthetic scope never proves live availability or scientific validity.",
  "x-rwb-document-kind": "capability_conformance_evidence",
  "type": "object",
  "required": [
    "fixture_kind",
    "fixture_id",
    "implementation_ref",
    "scope",
    "checks",
    "result",
    "limitations"
  ],
  "properties": {
    "fixture_kind": { "const": "synthetic-capability-conformance" },
    "fixture_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "implementation_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "scope": { "const": "synthetic-bounded-fixture" },
    "checks": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "result": { "enum": ["pass", "fail"] },
    "limitations": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
