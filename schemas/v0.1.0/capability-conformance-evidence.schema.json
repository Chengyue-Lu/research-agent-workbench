{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/capability-conformance-evidence.schema.json",
  "title": "Capability Conformance Evidence",
  "$comment": "Typed, content-addressed evidence for one implementation. It binds identity, evidence class, observation scope, capability claim, and result without defining Provider- or Runtime-specific admission.",
  "x-rwb-document-kind": "capability_conformance_evidence",
  "type": "object",
  "required": [
    "evidence_kind",
    "evidence_id",
    "implementation_ref",
    "implementation_version",
    "capability_ids",
    "scope",
    "checks",
    "result",
    "limitations"
  ],
  "properties": {
    "evidence_kind": {
      "enum": ["deterministic-fixture", "local-conformance", "live-conformance"]
    },
    "evidence_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "implementation_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "implementation_version": { "$ref": "common.schema.json#/$defs/semver" },
    "capability_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope": {
      "oneOf": [
        { "$ref": "#/$defs/fixtureScope" },
        { "$ref": "#/$defs/observationScope" }
      ]
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "result": { "enum": ["pass", "fail"] },
    "limitations": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_kind": { "const": "deterministic-fixture" } },
        "required": ["evidence_kind"]
      },
      "then": { "properties": { "scope": { "$ref": "#/$defs/fixtureScope" } } },
      "else": { "properties": { "scope": { "$ref": "#/$defs/observationScope" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "fixtureScope": {
      "type": "object",
      "required": ["scope_kind", "fixture_id"],
      "properties": {
        "scope_kind": { "const": "synthetic-bounded-fixture" },
        "fixture_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "observationScope": {
      "type": "object",
      "required": ["scope_kind", "scope_ref"],
      "properties": {
        "scope_kind": { "enum": ["local-environment", "provider-observation"] },
        "scope_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  }
}
