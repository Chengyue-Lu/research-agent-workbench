{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/promotion-validation-authority-registry.schema.json",
  "title": "Promotion Validation Authority Registry",
  "$comment": "Pre-Attempt owner-maintained acceptance registry. Stable-directory placement alone never grants authority.",
  "x-rwb-document-kind": "promotion_validation_authority_registry",
  "type": "object",
  "required": [
    "schema_version", "registry_id", "revision", "accepted_policies",
    "authority_boundaries"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "registry_id": { "const": "RWB-PROMOTION-VALIDATION-AUTHORITY" },
    "revision": { "type": "integer", "minimum": 1 },
    "accepted_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "task_id", "task_revision", "policy_ref", "checker", "runner",
          "host", "accepted_at", "accepted_by"
        ],
        "properties": {
          "task_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "task_revision": { "type": "integer", "minimum": 1 },
          "policy_ref": { "$ref": "common.schema.json#/$defs/fileRef" },
          "checker": { "$ref": "deterministic-check-report.schema.json#/properties/checker" },
          "runner": { "$ref": "promotion-validation-policy.schema.json#/properties/runner" },
          "host": { "$ref": "#/$defs/host" },
          "accepted_at": { "type": "string", "format": "date-time" },
          "accepted_by": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    },
    "authority_boundaries": {
      "type": "object",
      "required": [
        "pre_attempt_acceptance", "validation_execution_fact",
        "promotion_execution", "claim_acceptance", "human_decision",
        "scientific_correctness"
      ],
      "properties": {
        "pre_attempt_acceptance": { "const": true },
        "validation_execution_fact": { "const": false },
        "promotion_execution": { "const": false },
        "claim_acceptance": { "const": false },
        "human_decision": { "const": false },
        "scientific_correctness": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "host": {
      "type": "object",
      "required": ["host_id", "version", "source_ref"],
      "properties": {
        "host_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "version": { "$ref": "common.schema.json#/$defs/semver" },
        "source_ref": { "$ref": "common.schema.json#/$defs/fileRef" }
      },
      "additionalProperties": false
    }
  }
}
