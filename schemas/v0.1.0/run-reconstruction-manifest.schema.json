{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent-workbench.local/schemas/v0.1.0/run-reconstruction-manifest.schema.json",
  "title": "Bounded Run Reconstruction Manifest",
  "x-rwb-document-kind": "run_reconstruction_manifest",
  "type": "object",
  "required": ["schema_version", "manifest_kind", "manifest_id", "run_id", "run_ref", "code_ref", "input_ref", "parameters_ref", "environment_ref", "input_bindings", "environment_binding", "expected_outputs", "timeout_seconds", "negative_result", "limitations", "authority_boundaries"],
  "$defs": {
    "objectFileBinding": {
      "type": "object", "required": ["object_ref", "file_ref"],
      "properties": {
        "object_ref": {"$ref": "common.schema.json#/$defs/objectRef"},
        "file_ref": {"$ref": "common.schema.json#/$defs/fileRef"}
      }, "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "manifest_kind": {"const": "python-file-reconstruction"},
    "manifest_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "run_ref": {"allOf": [{"$ref": "common.schema.json#/$defs/fileRef"}, {"required": ["revision"]}]},
    "code_ref": {"$ref": "common.schema.json#/$defs/fileRef"},
    "input_ref": {"$ref": "common.schema.json#/$defs/fileRef"},
    "parameters_ref": {"$ref": "common.schema.json#/$defs/fileRef"},
    "environment_ref": {"$ref": "common.schema.json#/$defs/fileRef"},
    "input_bindings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/objectFileBinding"}},
    "environment_binding": {"$ref": "#/$defs/objectFileBinding"},
    "promotion_receipt_ref": {"$ref": "common.schema.json#/$defs/fileRef"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 90},
    "negative_result": {"type": "boolean"},
    "expected_outputs": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "required": ["output_path", "object_ref", "artifact_ref"],
        "properties": {
          "output_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "object_ref": {"$ref": "common.schema.json#/$defs/objectRef"},
          "artifact_ref": {"$ref": "common.schema.json#/$defs/fileRef"}
        }, "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_boundaries": {
      "type": "object", "required": ["claim_acceptance", "human_decision", "scientific_correctness", "promotion"],
      "properties": {"claim_acceptance": {"const": false}, "human_decision": {"const": false}, "scientific_correctness": {"const": false}, "promotion": {"const": false}},
      "additionalProperties": false
    }
  }, "additionalProperties": false
}
