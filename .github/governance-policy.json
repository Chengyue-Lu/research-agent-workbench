{
  "schema_version": 1,
  "risk_order": ["R0", "R1", "R2"],
  "finding_severities": ["INFO", "WARNING", "ERROR"],
  "pr_classes": ["feature", "task-definition", "release"],
  "task_statuses": ["DONE", "IN_PROGRESS", "READY", "BLOCKED", "PARKED"],
  "task_transitions": {
    "PARKED": ["READY"],
    "READY": ["IN_PROGRESS", "DONE", "BLOCKED"],
    "IN_PROGRESS": ["DONE", "BLOCKED"],
    "BLOCKED": ["READY", "IN_PROGRESS", "DONE"],
    "DONE": []
  },
  "owners": {
    "Chengyue-Lu": "chengyue-lu",
    "let778750-cpu": "huangyi"
  },
  "minimum_risk_paths": {
    "R1": [
      "schemas/**",
      "registry/**",
      "docs/compatibility/**",
      "docs/implementation/**",
      "docs/STATUS.md",
      "src/research_workbench/cli.py",
      "src/research_workbench/protocol/**",
      "src/research_workbench/contracts/**"
    ],
    "R2": [
      ".github/**",
      "AGENTS.md",
      "docs/ARCHITECTURE.md",
      "docs/PROJECT_CHARTER.md",
      "docs/decisions/**",
      "docs/implementation/DECISION_AUTHORITY.md",
      "registry/authority/**",
      "src/research_workbench/protocol/authority.py",
      "schemas/**/decision-authority*.schema.json",
      "schemas/**/authority-rule-eligibility.schema.json",
      "schemas/**/method-resolution.schema.json",
      "schemas/**/capability-requirement*.schema.json",
      "registry/capabilities/requirements.json",
      "registry/capabilities/requirements/**",
      "src/research_workbench/capability/requirements.py",
      "schemas/**/skill-need*.schema.json",
      "registry/skill-needs.json",
      "registry/skill-needs/**",
      "src/research_workbench/capability/skill_needs.py",
      "schemas/**/capability-supply*.schema.json",
      "schemas/**/capability-resolution.schema.json",
      "schemas/**/resolved-capability-snapshot.schema.json",
      "schemas/**/capability-conformance-evidence.schema.json",
      "src/research_workbench/capability/supply.py",
      "examples/capability-resolution/**",
      "schemas/**/skill-lifecycle*.schema.json",
      "registry/skills/lifecycle-v2.json",
      "registry/skills/lifecycle/**",
      "registry/skills/lifecycle-migrations/**",
      "src/research_workbench/capability/lifecycle.py",
      "schemas/**/protocol-profile*.schema.json",
      "registry/protocol-profiles.json",
      "registry/protocol-profiles/**",
      "src/research_workbench/protocol/profiles.py",
      "schemas/**/claim*.schema.json",
      "schemas/**/decision*.schema.json",
      "schemas/**/human-gate*.schema.json",
      "schemas/**/permission*.schema.json",
      "schemas/**/data-policy*.schema.json",
      "src/research_workbench/governance/**",
      "src/research_workbench/security/**"
    ]
  },
  "published_identities": [
    {
      "kind": "mode-action",
      "patterns": [
        "registry/modes/actions/*.yaml",
        "registry/modes/actions/*.yml",
        "registry/modes/actions/**/*.yaml",
        "registry/modes/actions/**/*.yml"
      ],
      "identity_fields": ["action_id", "version"]
    },
    {
      "kind": "research-mode",
      "patterns": [
        "registry/modes/*.yaml",
        "registry/modes/*.yml",
        "registry/modes/v*/*.yaml",
        "registry/modes/v*/*.yml"
      ],
      "identity_fields": ["mode_id", "version"]
    },
    {
      "kind": "decision-authority-matrix",
      "patterns": [
        "registry/authority/decision-authority-matrix*.yaml",
        "registry/authority/decision-authority-matrix*.yml",
        "registry/authority/decision-authority-matrix*.json"
      ],
      "identity_fields": ["matrix_id", "version"]
    },
    {
      "kind": "research-mode-migration",
      "patterns": [
        "registry/modes/migrations/*.yaml",
        "registry/modes/migrations/*.yml",
        "registry/modes/migrations/**/*.yaml",
        "registry/modes/migrations/**/*.yml"
      ],
      "identity_fields": ["migration_id", "migration_version"]
    },
    {
      "kind": "capability-requirement",
      "patterns": [
        "registry/capabilities/requirements/*.yaml",
        "registry/capabilities/requirements/*.yml",
        "registry/capabilities/requirements/**/*.yaml",
        "registry/capabilities/requirements/**/*.yml"
      ],
      "identity_fields": ["requirement_id"]
    },
    {
      "kind": "skill-need",
      "patterns": [
        "registry/skill-needs/*.yaml",
        "registry/skill-needs/*.yml",
        "registry/skill-needs/**/*.yaml",
        "registry/skill-needs/**/*.yml"
      ],
      "identity_fields": ["need_id", "version"]
    },
    {
      "kind": "protocol-profile",
      "patterns": [
        "registry/protocol-profiles/*.yaml",
        "registry/protocol-profiles/*.yml",
        "registry/protocol-profiles/**/*.yaml",
        "registry/protocol-profiles/**/*.yml"
      ],
      "identity_fields": ["profile_id", "version"]
    },
    {
      "kind": "skill-lifecycle-record",
      "patterns": [
        "registry/skills/lifecycle/*.yaml",
        "registry/skills/lifecycle/*.yml",
        "registry/skills/lifecycle/**/*.yaml",
        "registry/skills/lifecycle/**/*.yml"
      ],
      "identity_fields": ["lifecycle_id", "lifecycle_version"]
    },
    {
      "kind": "skill-lifecycle-migration",
      "patterns": [
        "registry/skills/lifecycle-migrations/*.yaml",
        "registry/skills/lifecycle-migrations/*.yml",
        "registry/skills/lifecycle-migrations/**/*.yaml",
        "registry/skills/lifecycle-migrations/**/*.yml"
      ],
      "identity_fields": ["migration_id", "migration_version"]
    }
  ]
}
